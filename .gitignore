# Unity - https://github.com/github/gitignore/blob/main/Unity.gitignore
# Place at the repository root (same level as Assets/, Packages/, ProjectSettings/).

# Unity generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Rr]ecordings/**/*

# Unity asset store / package cache (if present outside Library)
[Aa]ssets/AssetStoreTools*

# Autogenerated project / solution files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files (only when a file is deleted locally)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports / diagnostics
sysinfo.txt
*.crash
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE / editor (keep shared settings via exceptions below)
.vs/
.idea/
*.swp
*.swo
*~

# VS Code - ignore local editor state; allow shared workspace settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains Rider
*.sln.iml
.idea/

# Plastic SCM (Unity Version Control)
.plastic/
ignore.conf

# Gradle (Android)
.gradle/
**/gradle-wrapper.jar

# Addressables / local build output (if used later)
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# Burst debug symbols (local only)
*_BurstDebugInformation_DoNotShip/

# Test results
[Tt]est[Rr]esults/
*.coverage
*.coveragexml

# NuGet (if used - do not use "packages/" here; macOS FS is case-insensitive
# and would ignore Unity's Packages/ folder)
**/nuget-packages/

# Local env / secrets - never commit
.env
.env.*
*.pem
*.key
